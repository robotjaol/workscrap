{
  "manifest_version": 3,
  "name": "Career Pulse",
  "version": "1.0.0",
  "description": "Pantau portal karier dan kirim lowongan baru ke Telegram.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.telegram.org/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.taleo.net/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Career Pulse",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
